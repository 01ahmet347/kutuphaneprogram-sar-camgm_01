rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isStudent(userId) {
      return signedIn()
        && request.auth.token.role == 'student'
        && request.auth.uid == userId;
    }

    match /artifacts/{appId}/public/data/sgmConfig/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/sgmDesks/{deskId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/sgmUsers/{userId} {
      allow get: if isAdmin() || isStudent(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/sgmMessages/{userId} {
      allow get: if isAdmin() || isStudent(userId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/public/data/{collection}/{documentId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
